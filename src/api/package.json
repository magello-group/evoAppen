{
  "name": "evoappen-rest-api",
  "version": "0.1.0",
  "description": "EvoAppen REST API",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "watch": "tsc -w",
    "prebuild": "npm run lint",
    "build": "tsc -b .",
    "prestart": "npm run clean && npm run build",
    "start": "node .",
    "dev": "nodemon src/index.ts",
    "test": "jest --coverage"
  },
  "author": "",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "<rootDir>/**/*.spec.ts"
    ]
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@types/jsonwebtoken": "^9.0.10",
    "applicationinsights": "^3.12.1",
    "config": "^4.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "jwks-rsa": "^3.2.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.23",
    "winston": "^3.18.3",
    "winston-transport": "^4.9.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/config": "^3.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "brace-expansion": "^4.0.1",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "js-yaml": "^4.1.1",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
