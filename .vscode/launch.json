{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Web (Chrome)",
            "request": "launch",
            "type": "chrome",
            "webRoot": "${workspaceFolder}/src/web/src",
            "url": "http://localhost:5173",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/*"
            },
            "preLaunchTask": "npm start (web)"
        },
        {
            "name": "Debug Web (Edge)",
            "request": "launch",
            "type": "msedge",
            "webRoot": "${workspaceFolder}/src/web/src",
            "url": "http://localhost:5173",
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/*"
            },
            "preLaunchTask": "npm start (web)"
        },
        {
            "name": "Debug API",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/src/api",
            "envFile": "${workspaceFolder}/src/api/.env",
            "env": {
                "NODE_ENV": "development"
            },
            "outputCapture": "std",
            "preLaunchTask": "npm clean (api)"
        }
    ]
}