{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm build both (api + web)",
            "dependsOn": [
                "npm build (api)",
                "npm build (web)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "type": "shell",
            "label": "npm build (api)",
            "command": "npm run build",
            "dependsOn": "npm clean (api)",
            "problemMatcher": "$tsc",
            "options": {
                "cwd": "${workspaceFolder}/src/api"
            }
        },
        {
            "type": "shell",
            "label": "npm watch (api)",
            "command": "npm run watch",
            "dependsOn": "npm clean (api)",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}/src/api"
            }
        },
        {
            "type": "shell",
            "label": "npm install (api)",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/src/api"
            }
        },
        {
            "type": "shell",
            "label": "npm prune (api)",
            "command": "npm prune --production",
            "dependsOn": "npm build (api)",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/src/api"
            }
        },
        {
            "type": "shell",
            "label": "npm clean (api)",
            "command": "npm run clean",
            "dependsOn": "npm install (api)",
            "options": {
                "cwd": "${workspaceFolder}/src/api"
            }
        },
        {
            "label": "npm start (web)",
            "type": "shell",
            "command": "npm run dev",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "vite v\\d+\\.\\d+\\.\\d+",
                        "endsPattern": "Local:.*localhost:\\d+"
                    }
                }
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/web"
            }
        },
        {
            "type": "shell",
            "label": "npm build (web)",
            "command": "npm run build",
            "dependsOn": "npm clean (web)",
            "problemMatcher": "$tsc",
            "options": {
                "cwd": "${workspaceFolder}/src/web"
            }
        },        
        {
            "type": "shell",
            "label": "npm install (web)",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/src/web"
            }
        },
        {
            "type": "shell",
            "label": "npm prune (web)",
            "command": "npm prune --production",
            "dependsOn": "npm build (web)",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/src/web"
            }
        },
        {
            "type": "shell",
            "label": "npm clean (web)",
            "command": "npm run clean",
            "dependsOn": "npm install (web)",
            "options": {
                "cwd": "${workspaceFolder}/src/web"
            }
        }        
    ]
}